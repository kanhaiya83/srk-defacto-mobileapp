# =============================================================================
# Defacto ERP — mobile configuration
#
# Copy to `.env`. Expo inlines any EXPO_PUBLIC_-prefixed variable into the
# bundle at build time, so treat every value here as PUBLIC. Never put secrets,
# API keys, or credentials in this file.
# =============================================================================

# Base URL of the API. Must be listed in the server's CORS_ORIGINS allowlist,
# and must be https in production so the refresh cookie (Secure; SameSite=None)
# is accepted. Falls back to `expo.extra.apiUrl` in app.json when unset.
EXPO_PUBLIC_API_URL=https://defacto.srk.aws.heykanhaiya.xyz
